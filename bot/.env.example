# Скопируйте в .env и заполните реальными значениями.
# Токен MAX-бота (или используйте in_help/pass.md)
MAX_BOT_TOKEN=

# DaData API — поиск компании по ИНН (dadata.ru)
DADATA_API_KEY=

# Cloud.ru Foundation Models — разбор B2B-заявок свободным текстом
CLOUDRU_API_KEY=

# Опционально: публичный URL мини-аппа для кнопок в MAX-уведомлениях
MINIAPP_URL=
