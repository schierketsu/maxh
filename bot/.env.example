# Скопируйте в .env и заполните реальными значениями.
# Токен MAX-бота (или используйте in_help/pass.md)
MAX_BOT_TOKEN=

# DaData API — поиск компании по ИНН (dadata.ru)
DADATA_API_KEY=

# Cloud.ru Foundation Models — разбор B2B-заявок свободным текстом
CLOUDRU_API_KEY=

# Опционально, сейчас не используется ботом (вся B2B-сеть работает прямо в
# чате — см. bot/src/b2bChat.js) — задел на потом, когда мини-апп будет
# задеплоен и мы снова начнём давать на него ссылки.
MINIAPP_URL=

# Дополнительные origin для CORS через запятую. По умолчанию разрешены
# hackmax.ru и localhost:5173 — переменная нужна, если мини-апп поднимают
# на другом адресе, а API берут с этого сервера.
ALLOWED_ORIGINS=

# Адрес MAX Bot API. platform-api2.max.ru требует сертификат Минцифры
# и ради него клиент отключает проверку TLS. Указывайте адрес ниже —
# тот же контракт, обычный сертификат, проверка работает.
MAX_API_BASE=https://platform-api.max.ru
