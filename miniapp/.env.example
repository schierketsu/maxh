# Скопируйте в .env и заполните реальными значениями.

# Базовый URL HTTP API бота (bot/src/server.js). Пусто — относительные
# запросы к текущему origin (прод, где мини-апп и API за одним доменом).
VITE_API_BASE_URL=

# Ключ Yandex Maps JS API v3 (api-maps.yandex.ru), кабинет разработчика
# Яндекса. Ключ ограничен по HTTP Referer на стороне Яндекса и всё равно
# виден в собранном фронтенд-бандле любому пользователю — это не секрет
# в смысле "нельзя раскрывать", а просто явно вынесенный параметр сборки.
VITE_YANDEX_MAPS_API_KEY=
