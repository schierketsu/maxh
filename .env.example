# Шаблон переменных решения. Заполняется одной командой:
#
#   ./setup-env.sh                 # Linux / macOS / Git Bash
#   .\setup-env.ps1                # Windows PowerShell
#
# Значения ключей — на первом слайде презентации. В репозитории их нет:
# условия хакатона запрещают хранить рабочие токены в коде.
#
# Этот один файл читают docker compose, чат-бот при запуске без Docker
# и Vite при сборке мини-приложения.

# --- Чат-бот ---------------------------------------------------------------
# Токен чат-бота, выдают организаторы.
MAX_BOT_TOKEN=
# Ключ DaData: профиль компании по ИНН. Без него поиск компании вернёт 502.
DADATA_API_KEY=
# Ключ Cloud.ru Foundation Models: разбор заявки свободным текстом и
# рекомендации. Без него заявку текстом создать нельзя, рекомендации
# откатываются на эвристику по ОКВЭД.
CLOUDRU_API_KEY=
# Публичный адрес мини-приложения для кнопок open_app в уведомлениях бота.
MINIAPP_URL=

# Адрес MAX API. platform-api2.max.ru требует сертификат Минцифры, и ради
# него клиент отключает проверку TLS; адрес ниже работает с проверкой.
MAX_API_BASE=https://platform-api.max.ru

# Long polling при локальном запуске. off — чтобы не конфликтовать с ботом
# на боевом стенде: два клиента с одним токеном делят апдейты между собой.
BOT_POLLING=off

# Дополнительные origin для CORS через запятую. По умолчанию разрешены
# hackmax.ru и localhost:5173.
ALLOWED_ORIGINS=

# --- Мини-приложение -------------------------------------------------------
# Ключ Yandex Maps JS API v3 для экрана карты. Вшивается в бандл при сборке
# и виден в собранном коде — это параметр сборки, а не секрет.
VITE_YANDEX_MAPS_API_KEY=
# Пусто — запросы идут к текущему origin, мини-апп и API за одним адресом.
VITE_API_BASE_URL=

# Порт, на котором откроется мини-приложение.
MINIAPP_PORT=8080
