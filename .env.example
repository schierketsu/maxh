# Переменные для docker compose. Скопируйте в .env и заполните:
#   cp .env.example .env
#
# Секреты бота (токен MAX, DaData, Cloud.ru) живут отдельно, в bot/.env —
# см. bot/.env.example.

# Ключ Yandex Maps JS API v3 для экрана карты. Вшивается в бандл на этапе
# сборки и виден в собранном коде — это параметр сборки, а не секрет.
VITE_YANDEX_MAPS_API_KEY=

# Порт, на котором откроется мини-приложение. По умолчанию 8080.
MINIAPP_PORT=8080

# Long polling к MAX при локальном запуске. По умолчанию off:
# бот уже работает на боевом стенде, а два клиента с одним токеном
# делят апдейты между собой. Включать, только остановив боевого бота.
BOT_POLLING=off
